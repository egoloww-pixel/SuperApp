QMainWindow, QWidget {
    background-color: #f7f8fa;
    color: #222;
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

#Sidebar {
    background-color: #1f2430;
    color: #d5d8de;
    border: none;
    padding: 8px 0;
    outline: 0;
}

#Sidebar::item {
    padding: 10px 16px;
    border: none;
}

#Sidebar::item:selected {
    background-color: #2d3548;
    color: #ffffff;
    border-left: 3px solid #4c8bf5;
}

#Sidebar::item:hover {
    background-color: #262c3a;
}

QPushButton {
    background-color: #4c8bf5;
    color: white;
    border: none;
    padding: 6px 14px;
    border-radius: 4px;
}

QPushButton:hover { background-color: #3f7ce0; }
QPushButton:pressed { background-color: #356cc7; }
QPushButton:disabled { background-color: #b9c3d6; color: #eef1f6; }

QComboBox, QDateEdit, QLineEdit {
    background: white;
    border: 1px solid #c9cfdb;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 22px;
}

QComboBox:focus, QDateEdit:focus, QLineEdit:focus {
    border-color: #4c8bf5;
}

QTableWidget {
    background: white;
    border: 1px solid #dde2ec;
    gridline-color: #eef1f6;
}

QHeaderView::section {
    background-color: #eef1f6;
    padding: 6px 8px;
    border: none;
    border-right: 1px solid #dde2ec;
    font-weight: 600;
}

QStatusBar {
    background: #eef1f6;
    color: #555;
}
